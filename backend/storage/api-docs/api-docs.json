    "paths": {
        "/api/reservations": {
            "get": {
                "tags": [
                    "Reservation"
                ],
                "summary": "Fetch all reservations",
                "operationId": "f10e68ff0ce263ef754b2f640eda8d93",
                "responses": {
                    "200": {
                        "description": "Success"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            },
            "post": {
                "tags": [
                    "Reservation"
                ],
                "summary": "Create a new reservation",
                "description": "This endpoint allows users to create a new reservation.",
                "operationId": "4f59911f11563f79b4f01bd02222607d",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "date",
                                    "heure",
                                    "prix",
                                    "statut_reservation",
                                    "statut_paiement",
                                    "taille",
                                    "id_utilisateur"
                                ],
                                "properties": {
                                    "date": {
                                        "type": "string",
                                        "format": "date",
                                        "example": "2025-01-07"
                                    },
                                    "heure": {
                                        "type": "string",
                                        "format": "time",
                                        "example": "14:30:00"
                                    },
                                    "prix": {
                                        "type": "number",
                                        "format": "float",
                                        "example": 50.75
                                    },
                                    "statut_reservation": {
                                        "type": "string",
                                        "example": "confirmée"
                                    },
                                    "statut_paiement": {
                                        "type": "string",
                                        "example": "payé"
                                    },
                                    "taille": {
                                        "type": "integer",
                                        "example": 3
                                    },
                                    "id_utilisateur": {
                                        "type": "integer",
                                        "example": 1
                                    },
                                    "id_visite": {
                                        "type": "integer",
                                        "example": 1,
                                        "nullable": true
                                    },
                                    "id_spr": {
                                        "type": "integer",
                                        "example": 1,
                                        "nullable": true
                                    },
                                    "id_guide": {
                                        "type": "integer",
                                        "example": 2,
                                        "nullable": true
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Reservation created successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Reservation created successfully"
                                        },
                                        "data": {
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Validation failed"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/reservations/{id}": {
            "put": {
                "tags": [
